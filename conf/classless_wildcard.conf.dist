#
# mod-classless-wildcard configuration
#

[worldserver]

########################################
# General
########################################
#
#    ClasslessWildcard.Enable
#        Enable the classless / wildcard system.
#        Default: 1
#
#    ClasslessWildcard.Announce
#        Send login/level status messages to players.
#        Default: 1
#
#    ClasslessWildcard.DefaultMode
#        Mode assigned when a player doesn't choose one in time.
#        0 = Classless (free-pick), 1 = Wildcard (random rolls)
#        Default: 0
#
#    ClasslessWildcard.AllowModeChoice
#        Let each character pick its own mode at the Hero Advancement NPC
#        (or .classless mode) before the deadline level. If 0, DefaultMode
#        applies to everyone (realm-wide mode).
#        Default: 1
#
#    ClasslessWildcard.ModeChoiceDeadline
#        Level at which an unchosen character is locked into DefaultMode.
#        Default: 5

#
#    ClasslessWildcard.ExemptAccountPrefixes
#        Comma-separated account-name prefixes that play with VANILLA class
#        rules: no essences or rolls, native talent points, class trainers
#        work. Required for mod-playerbots: its random-bot accounts
#        (default prefix "rndbot") initialize their spells and talents
#        directly and must not be stripped by the classless system.
#        Default: "rndbot"

ClasslessWildcard.Enable = 1
ClasslessWildcard.Announce = 1
ClasslessWildcard.ExemptAccountPrefixes = "rndbot"
ClasslessWildcard.DefaultMode = 0
ClasslessWildcard.AllowModeChoice = 1
ClasslessWildcard.ModeChoiceDeadline = 5

########################################
# Spell library
########################################
#
#    ClasslessWildcard.IncludeDeathKnight
#        Include Death Knight spells/talents in the library.
#
#        DK abilities cost RUNES, and the core only builds a character's rune
#        block for a Death Knight. With this on, the module answers the "is
#        this a Death Knight?" question the rune code asks, so every Hero gets
#        a working rune block, rune cooldowns and runic power. With it off
#        nothing is allocated and nothing ticks.
#
#        The stock UI draws the rune bar only for real Death Knight characters,
#        so the server mirrors the rune block over the addon channel and the
#        addon draws six pips -- coloured by rune type, dimmed while on
#        cooldown -- plus a runic power bar, under the resource mini-bars. They
#        appear only once the server actually sends runes, so nothing changes
#        on a realm with this off.
#
#        Still experimental: rune COSTS and regeneration are the core's, but no
#        Hero has the Death Knight talents and passives those abilities were
#        balanced around, so expect the numbers to feel odd before they feel
#        broken.
#        Default: 0

#
#    ClasslessWildcard.IncludeRacials
#        Include racial spells in the library.
#        Default: 0
#
#    ClasslessWildcard.IncludePassives
#        Include passive class spells in the ability library.
#        Default: 1
#
#    ClasslessWildcard.ExcludedSpells
#        Comma-separated spell ids to remove from the library entirely.
#        Default: ""
#
#    ClasslessWildcard.TrainerTaughtOnly
#        Only spells that classes ACTUALLY learn enter the library: starter
#        spells plus everything on class trainer lists (npc_trainer). This
#        removes NPC/pet spell variants (e.g. "Demonic Immolate") and gives
#        every rank its true trainer learn level, which tiering and rarity
#        are based on.
#        Default: 1
#
#    ClasslessWildcard.RespectLevelRequirements
#        Tiered acquisition: rolls and purchases respect each spell's own
#        learn level (rank 1) and each talent's tree-row level (10 + row*5),
#        so low-level Heroes can't be dealt end-game spells. If the level-legal
#        pool is ever exhausted, rolls fall back to the full pool rather than
#        being lost.
#        Default: 1

ClasslessWildcard.IncludeDeathKnight = 0
ClasslessWildcard.IncludeRacials = 0
ClasslessWildcard.IncludePassives = 1
ClasslessWildcard.ExcludedSpells = ""
ClasslessWildcard.TrainerTaughtOnly = 1
ClasslessWildcard.RespectLevelRequirements = 1

########################################
# Proficiencies & talents
########################################
#
#    ClasslessWildcard.TeachProficiencies
#        Teach all armor/weapon proficiencies on login (classless gear use).
#        Default: 1
#
#    ClasslessWildcard.ProficiencySpells
#        The proficiency spells taught, plus the ranged use-abilities:
#        Shoot 5019 fires WANDS only; bows/guns/crossbows need Shoot 3018 and
#        thrown weapons need Throw 2764. (Those two are also auto-taught
#        whenever the matching proficiency is in this list, so older lists
#        keep working.)
#        Default: cloth/leather/mail/plate/shield, all weapon types, wands,
#                 wand Shoot, ranged Shoot, Throw, dual wield
#
#    ClasslessWildcard.SuppressTalentPoints
#        Zero out native talent points (talents flow through the module).
#        Default: 1

#
#    ClasslessWildcard.BlockOutsideSpellSources
#        Class trainers (and the odd quest reward) would let players learn
#        class spells for gold, bypassing the essence/roll economy. When
#        enabled, any classless-library spell learned outside the module is
#        reverted with a hint pointing at the Hero Advancement system.
#        Profession/secondary trainers are unaffected.
#        Default: 1

#
#    ClasslessWildcard.ClasslessClassChecks
#        The core asks "is this player a <class>?" wherever behaviour is
#        class-specific. Every Hero runs one chassis, so by default the chassis
#        answers -- and a classless character inherits its restrictions. With
#        this on the module answers YES for the cases where classless should
#        mean every class at once:
#
#          * equipping ANY relic. Libram, Idol, Totem, Sigil and the warlock
#            relic all share slot 17, but the core hands that slot to one class
#            each. On the Paladin chassis a Hero could wear a Libram and nothing
#            else, however much druid or shaman their build had bought.
#          * shields, which the core limits to Paladin/Warrior/Shaman. The
#            default chassis passes anyway; this keeps it true on any chassis.
#          * the reactive-ability aura states behind Overpower, Revenge,
#            Riposte and Counterattack, which the core sets only for the class
#            each belongs to.
#          * pets. Pet::Create types a pet from its owner's class, so on a
#            one-chassis realm every summoned pet came out untyped: an error
#            logged on each summon, no dismiss prompt, and the pet not recorded
#            as the current one. The module types it from the pet instead --
#            tamed beasts are hunter pets, everything else is a summoned pet --
#            and answers the warlock pet question so a demon counts as
#            permanent. The Death Knight pet question is deliberately left
#            alone: LoadPetFromDB refuses to load a pet for a Death Knight
#            without the Master of Ghouls flag, so answering it would stop
#            pets loading at all.
#
#        Everything else keeps answering with the real chassis class on
#        purpose: Death Knight rune handling and the stat/talent maths break if
#        a character claims to be every class at once.
#        Default: 1

#
#    ClasslessWildcard.SpellbookTabs
#        Which spellbook tab a spell lands under is decided by the CLIENT, from
#        SkillLineAbility.dbc: each class has a fixed set of spec tabs (Holy,
#        Protection, Retribution for the Paladin chassis) and a known spell is
#        filed under one only if its own row says it belongs to that class --
#        so a rolled Fireball sat in General while its row said "Mage". The
#        client patch fixes that by making every class spell belong to every
#        class, and the addon builds the extra tab buttons, because Blizzard
#        only ever made 8 and a Hero can span all 33 spec lines. Empty tabs
#        stay hidden, so a Hero sees only the schools they actually know.
#
#        This setting is the SERVER half, and it is not about the tabs: it
#        keeps the Hero's class skill lines in step with what they know. The
#        core re-adds the chassis class's lines every login and auto-teaches
#        their starter spells with them (that is how Holy Light kept coming
#        back), so a line the Hero has nothing in is taken away, and lines they
#        do have something in are added so the core's own skill bookkeeping
#        stays consistent.
#
#          0 = off (stock behaviour: the chassis lines stay, starter spells
#              come back each login)
#          1 = keep lines in step with what the Hero owns (no empty lines)
#          2 = every class line present from the start
#
#        Default: 1

#
#    ClasslessWildcard.FormStarterKits
#        A shapeshift form or a warrior stance does nothing on its own. Draw
#        Bear Form out of the deck with nothing to go with it and you have
#        turned into a creature that cannot attack. With this on, gaining a form
#        also hands over the basic spells that go with it -- free, immediately,
#        and counting as owned abilities like anything else: Cat Form brings
#        Claw and Prowl, Bear Form brings Maul and Demoralizing Roar, Battle
#        Stance brings Charge, Defensive Stance Taunt, Berserker Stance Pummel.
#        The pairs are data, in the `cw_form_kits` world table -- add your own
#        rows, or set a row's `enabled` to 0 to drop just that one.
#
#        The same flag covers the reverse, which needs no table at all: an
#        ability that can ONLY be used in a stance or form hands over that form
#        when you gain it. Charge brings Battle Stance, Revenge Defensive
#        Stance, Whirlwind Berserker Stance, Shred Cat Form. Read from each
#        spell's own shapeshift mask, so it covers every stance-locked ability
#        in the game without naming any of them.
#        Default: 1

#
#    ClasslessWildcard.WorldDrops.*
#        Classless gear as world drops, so the Hero Advancement NPC is not the
#        only answer to "where does gear come from".
#
#        Enable (default 1): any mob can drop a piece of the classless
#        catalogue. The piece is banded to the MOB's level, not the killer's, so
#        a level 20 zone yields level 20 gear whoever kills there -- farming
#        low-level mobs at 80 returns low-level gear, exactly as normal loot
#        does. Critters, totems, pets and summons never drop.
#
#        Chance (default 1.0): percent chance per qualifying kill, so roughly
#        one piece per hundred mobs.
#
#        RareMultiplier (default 5.0): Chance is multiplied by this for rares,
#        rare elites and world bosses.
#
#        HeirloomChance (default 2.0): percent chance for a scaling heirloom,
#        rolled ONLY on rares, rare elites and world bosses, and rolled before
#        the ordinary drop as the better prize. Heirlooms scale to 80, so this
#        is the one that really matters -- set it to 0 to keep them vendor-only.
#
#        Nothing here touches creature_loot_template: drops are added to the
#        kill's loot in C++, so there is no world data to revert.

#
#    ClasslessWildcard.StripStartingSpells
#        Clean-slate creation: remove the chassis class's default class
#        abilities at first login. Heroes then get everything through essences
#        (classless) or rolls (wildcard). Racials, languages and Attack are
#        untouched.
#        Default: 1
#
#    ClasslessWildcard.StarterKit.*
#        The neutral Hero kit given at creation.
#
#        StripEquipped (default 1): destroy EVERY piece of gear the shell class
#        was created wearing, so the Hero starts bare. Without this the shell's
#        default shirt/pants/boots stay on and the kit armour below falls
#        through to the bags instead of equipping.
#
#        StarterKit.Equip is auto-equipped after the strip (armour only, so it
#        lands on the character): Recruit's shirt/pants/boots by default. Do NOT
#        put weapons here -- weapons belong in Items so they go to the bag.
#
#        StarterKit.Bag: an 8-slot bag equipped at creation so the kit fits
#        (default 5573 = Green Leather Bag; 0 = no bag).
#
#        StarterKit.Items go into the BAGS, unequipped -- the neutral weapons
#        so the Hero can use any ability it rolls. The Hero equips a weapon from
#        the bag when they want one. Default: Worn Shortsword, Worn Wooden
#        Shield, one of each basic weapon type, a bow + 200 Rough Arrows, a gun
#        + 200 Light Shot, one Crude Throwing Axe (thrown weapons do not stack
#        or deplete on 3.3.5a, so one is all you need), and a stack of 20 Tough
#        Hunk of Bread + 20 Refreshing Spring Water so the Hero can eat and
#        drink back to full between fights.
#
#        No wand: 3.3.5a has nothing below a green that a level 1 character can
#        equip, and a green does not belong in a kit of worn starter weapons.
#
#        Each list is comma-separated item:count.

ClasslessWildcard.StripStartingSpells = 1
ClasslessWildcard.StarterKit.Enable = 1
ClasslessWildcard.StarterKit.StripEquipped = 1
ClasslessWildcard.StarterKit.Bag = 5573
ClasslessWildcard.StarterKit.Equip = "38:1,39:1,40:1"
ClasslessWildcard.StarterKit.Items = "25:1,2362:1,2092:2,36:1,1194:1,2361:1,12282:1,35:1,2504:1,2512:200,2508:1,2516:200,25861:1,4540:20,159:20"

ClasslessWildcard.TeachProficiencies = 1
ClasslessWildcard.BlockOutsideSpellSources = 1
ClasslessWildcard.ClasslessClassChecks = 1
ClasslessWildcard.SpellbookTabs = 1
ClasslessWildcard.FormStarterKits = 1
# Elemental ability variants: every physical strike in the pool also exists as
# Fiery, Frozen, Earthen, Venomous, Arcane, Shadow and Holy versions that deal
# their damage as that element, keep a little less of the weapon damage, add an
# elemental hit that scales with spell power, and where a slot allows carry one
# rider the element is known for. They roll and are bought like any ability, one
# rarity tier above their base (RarityBump). The rows live in
# cw_ability_variants and spell_dbc and are generated, not hand-written:
# data/sql/generators/gen_elemental_variants.py takes the weapon coefficient
# (85% by default, 75% for Holy) and the spell power coefficient (0.15) as its
# arguments, and writes the client manifest in the same run so tooltips match.
# Every player must reinstall the client patch after the rows change. The
# startup log names the generation id the rows came from, and the client
# installer prints the id of the manifest it applied; they must be the same.
#
# RollWeightPct is what keeps the Wildcard pool honest. Each strike gains seven
# variants, and RarityBump alone does not make them roll less often (with the
# default equal RarityWeights it changes only cost and colour). Each variant
# rolls at this percentage of its rarity weight, so at 15 the seven together
# add about one more copy of the base to the pool rather than seven. Raise it
# to see more elemental strikes; it does not affect Classless purchase costs.
#
# InPool: whether variants are dealt by Wildcard rolls and sold on the Classless
# path. Off, a Hero who already owns one keeps it and can still unlearn it;
# no new ones are handed out. This is the switch to use on a realm where
# variants have already been dealt. Enable = 0 does not register them at all,
# which is only safe before any have been given.
#
# ShowInBrowser: whether variants are listed in the addon's class menus and the
# Hero Advancement NPC's lists. Off, they still roll and still appear in My
# Build once owned; they are just not browsed.
ClasslessWildcard.Elemental.Enable = 1
ClasslessWildcard.Elemental.RarityBump = 1
ClasslessWildcard.Elemental.RollWeightPct = 15
ClasslessWildcard.Elemental.InPool = 1
ClasslessWildcard.Elemental.ShowInBrowser = 1
ClasslessWildcard.WorldDrops.Enable = 1
ClasslessWildcard.WorldDrops.Chance = 1.0
ClasslessWildcard.WorldDrops.RareMultiplier = 5.0
ClasslessWildcard.WorldDrops.HeirloomChance = 2.0
ClasslessWildcard.ProficiencySpells = "9078,9077,8737,750,9116,201,202,196,197,198,199,200,227,1180,15590,264,266,5011,2567,5009,5019,3018,2764,674"
ClasslessWildcard.SuppressTalentPoints = 1

########################################
# Classless (free-pick) economy: Ascension defaults
########################################

# Ability Essence follows a class's own pacing: a level 1 has 3 abilities, then
# one more every level from 4 (9 by level 9, 80 by level 80). Talent Essence
# starts at 10, one a level, the 71 points a class has at 80.
ClasslessWildcard.Classless.StartingAbilityEssence = 3
ClasslessWildcard.Classless.EssenceStartLevel = 4
ClasslessWildcard.Classless.AbilityEssencePerLevel = 1
ClasslessWildcard.Classless.TalentEssenceStartLevel = 10
ClasslessWildcard.Classless.TalentEssencePerLevel = 1
# AE cost per rarity: common,uncommon,rare,epic,legendary
ClasslessWildcard.Classless.AbilityCostByRarity = "1,2,3,5,8"
ClasslessWildcard.Classless.TalentCostPerRank = 1
# Optional: charge only the FIRST rank, so a talent costs one point however far
# you rank it. Off by default -- in Classless you pick what you buy, so every
# rank is paid for at TalentCostPerRank. (Wildcard is where a rank 5 costs "one
# point": the roll hands you the rank for free, whatever it lands on.)
ClasslessWildcard.Classless.TalentFlatCost = 0
ClasslessWildcard.Classless.EnforceTalentRows = 1
ClasslessWildcard.Classless.RefundOnUnlearn = 1
ClasslessWildcard.Classless.RespecCostGold = 50

########################################
# Wildcard mode: Season 10 defaults
########################################
#
#    Schedule: StartingAbilities random abilities at creation; from
#    RollStartLevel, one random talent every TalentEveryLevels and one
#    random ability every AbilityEveryLevels.
#
#    RarityWeights: roll weight per rarity (common,uncommon,rare,epic,legendary).
#    Season 9 rules (the default): equal weights, so every entry in the pool is
#    equally likely, "completely, 100% random", and finding legendaries never
#    lowers your chance to roll more. For Season-10-style rarity-weighted rolls
#    use descending weights such as "100,60,30,10,3".
#
#    NOTE: this also decides the RANK a rolled talent lands on, because a
#    talent's rank is its rarity (rank 1 common ... rank 5 legendary). With the
#    equal weights below, every rank is equally likely. A rank 5 talent is as
#    common as a rank 1. Use descending weights if you want high ranks to be
#    the rare, exciting find: "100,60,30,10,3" makes rank 5 about a 1.5% roll.
#
#    Synergy rolls, pity and bans, in full:
#
#      Every ability and talent in the pool carries the class mask it came from
#      (which classes could learn it). A Hero's own mask is the union of the
#      masks of everything it already owns. On a SYNERGY ROLL the candidate
#      pool is narrowed to entries sharing at least one class with that mask
#      before the weighted pick happens, so the result complements the build
#      instead of being drawn from the whole library. If nothing in the pool
#      matches, the roll proceeds normally and does not count as a synergy.
#
#      The chance that any given roll is a synergy roll is
#          SynergyBaseChance + (pity * SynergyIncrement), capped at 100
#      With the defaults: 10%, rising 10 points per pity point.
#
#      PITY COUNTS REROLLS, not rolls. Only a reroll increments it; a scheduled
#      level-up roll never does. So a Hero who never rerolls sits at a flat
#      SynergyBaseChance for the whole game, and a Hero who has rerolled nine
#      times without a synergy hit rolls the tenth at 100%. A synergy roll
#      resets pity to 0, and so does Rebirth.
#
#      Worth knowing before you tune this: the owned mask only ever grows.
#      Wildcard deals StartingAbilities random abilities at level 1, usually
#      from that many different classes, so within a few levels the mask covers
#      most of the game and the synergy filter excludes very little. Synergy
#      shapes the early build strongly and progressively less after that, while
#      still announcing itself in chat. Treat SynergyBaseChance and
#      SynergyIncrement as early-game controls. Set SynergyBaseChance to 0 to
#      turn synergy rolls off entirely.
#
#    SynergyBanRolls is a separate mechanic despite the shared prefix, and the
#    name is misleading: it is a REROLL COOLDOWN, not a ban list and nothing to
#    do with moderation. When a player rerolls something, that entry is held out
#    of their pool for a while so the reroll cannot immediately hand back the
#    exact thing they just rerolled. It applies whether or not the reroll cost
#    anything, so free rerolls below FreeRerollBelowLevel stamp a cooldown too.
#    It is automatic, per character,
#    stored in cw_char_bans, and survives logout. The cooldown is counted in
#    rolls, not time, and the replacement roll counts as the first one: the
#    default 25 keeps a rerolled entry out of 24 rolls, after which it can be
#    dealt again.
#
#    Be aware how long 24 rolls actually is. Every roll of either kind ticks
#    every cooldown the character has running, and on the default cadence
#    (TalentEveryLevels = 1, AbilityEveryLevels = 2, from RollStartLevel) a Hero
#    receives about 1.5 rolls per level. 24 rolls is therefore roughly SIXTEEN
#    LEVELS: reroll something at level 12 and it cannot return until about level
#    28. At the default this makes a reroll close to a permanent decision rather
#    than a do-over. Rerolling often shortens the wait, since each replacement
#    roll also ticks every cooldown.
#
#    Pick the value for the behaviour you want:
#      0   an entry can be dealt straight back by its own replacement roll
#      3   stops an immediate repeat, back in the pool within a couple of levels
#      25  (default) a rerolled entry is gone for most of a leveling stretch
#
#    Whatever the value, a cooldown never costs a Hero a level-appropriate roll.
#    If every entry the Hero could actually use is owned or on cooldown, the
#    cooldowns of that kind are released and the pool is rebuilt before the roll
#    falls back to entries above the Hero's level. Level-appropriateness outranks
#    the cooldown, which matters most below FreeRerollBelowLevel: rerolls there
#    cost nothing, so a player can churn them freely, while the pool of entries
#    legal at level 1 is the smallest it will ever be. Without the release, a
#    few minutes of free rerolling would starve the early pool outright.
#
#    This is NOT how you ban a problem ability realm-wide. For that, set
#    `enabled` = 0 on its row in cw_ability_override or cw_talent_override,
#    which removes it from the pool for every Hero permanently.

ClasslessWildcard.Wildcard.StartingAbilities = 4
ClasslessWildcard.Wildcard.RollStartLevel = 10
# The roll schedule. TalentRollOffset is a phase: with both cadences at 2 and
# the offset at 1, ability rolls land on the even levels from RollStartLevel and
# talent rolls on the odd ones, so a Hero gets exactly one roll every level and
# no level is empty. Set the offset to 0 and they stack on the same levels.
#
# Talents are deliberately no more frequent than abilities: a talent roll rolls
# its RANK too, and can hand over rank 5 outright, which is worth five ranks a
# Classless Hero would buy one at a time. One a level made talent power arrive
# far faster than ability power.
ClasslessWildcard.Wildcard.TalentEveryLevels = 2
ClasslessWildcard.Wildcard.TalentRollOffset = 1
ClasslessWildcard.Wildcard.AbilityEveryLevels = 2
ClasslessWildcard.Wildcard.FreeRerollBelowLevel = 10
ClasslessWildcard.Wildcard.RarityWeights = "100,100,100,100,100"
ClasslessWildcard.Wildcard.SynergyBaseChance = 10
ClasslessWildcard.Wildcard.SynergyIncrement = 10
ClasslessWildcard.Wildcard.SynergyBanRolls = 25
# Earned rerolls (the Ascension way): every level from RollStartLevel grants
# this many reroll charges, so rerolls flow with leveling itself. Charges are
# one pool spent on abilities and talents alike, and are spent before any scroll
# is touched.
#
# The grant is per LEVEL, not per roll. The starting hand at level 1 grants
# none: charges begin at RollStartLevel.
ClasslessWildcard.Wildcard.RerollsPerLevel = 3
# Reroll top-up items (cheap, sold by the Hero Advancement NPC; shipped in the
# module's world SQL). Consumed only when earned charges run out.
ClasslessWildcard.Wildcard.ScrollItemId = 990101
# Optional extra faucet: also grant FreeScrollCount Reroll Scrolls every
# FreeScrollEveryLevels levels (0 disables).
ClasslessWildcard.Wildcard.FreeScrollEveryLevels = 0
ClasslessWildcard.Wildcard.FreeScrollCount = 1
# Buy Scroll button (Hero Advancement panel): players can buy a Reroll Scroll
# straight from the addon, no NPC needed. Only available at or above the
# FreeRerollBelowLevel level (rerolls are free before then, so scrolls are
# pointless) -- the button hides and purchases are refused below it. Price is
# in COPPER and scales with level, so it reads as silver in the early game and
# only grows into gold near the cap: cost = ScrollBuyBaseCopper +
# ScrollBuyPerLevelCopper * level (100 copper = 1 silver, 10000 copper = 1 gold;
# the talent scroll is half). Defaults: ~55s at level 10, ~4g at level 80. Set
# ScrollBuyEnable = 0 to hide the button and leave scrolls to the NPC vendor.
ClasslessWildcard.Wildcard.ScrollBuyEnable = 1
ClasslessWildcard.Wildcard.ScrollBuyBaseCopper = 500
ClasslessWildcard.Wildcard.ScrollBuyPerLevelCopper = 500

########################################
# Chassis
########################################
#
#    Every Hero runs on ONE class, whatever was picked on the creation screen.
#    That is what makes this classless rather than "classless with a class
#    underneath": while characters keep different classes, the core's own
#    per-class math differs between them -- base stats, base health and mana,
#    which stat feeds attack power, the crit and dodge conversion ratios --
#    and the class a character happens to run on quietly becomes a build
#    decision again.
#
#    With one chassis that math is identical for everyone by construction, so
#    the class chosen at creation is nothing but the model and the name (and
#    the name reads "Hero" once the client patch is installed). Every stat
#    matters to every Hero, and no build is better served by one class than
#    another.
#
#    Characters are converted at creation, and existing characters convert on
#    their next login. Accounts matched by ExemptAccountPrefixes are left on
#    their real class.
#
#    ClasslessWildcard.Chassis.Enable
#        Force every character onto Chassis.Class. Turning this OFF returns
#        the module to per-class chassis behaviour, where a character's class
#        still affects its stats and resources.
#        Default: 1
#
#    ClasslessWildcard.Chassis.Class
#        The class id every Hero runs on. It MUST be a class with a real mana
#        pool. The supported set is therefore:
#          2 Paladin   5 Priest   7 Shaman   8 Mage   9 Warlock   11 Druid
#        Anything else -- Warrior, Rogue, Hunter, Death Knight -- is refused at
#        startup with an error in the log and replaced with Paladin. A Hero
#        casts whatever it learns, and a great many of those spells cost mana
#        or a percentage of base mana; on a rage or energy chassis the
#        character has neither pool, so those abilities would simply never
#        fire.
#
#        Paladin is the default and the one this module is built around: a real
#        base mana (so percentage-of-base-mana spell costs come out right),
#        spirit regen, plate base armour, and no forms, stances or runes to
#        suppress. Rage and energy are layered on top by the universal-resource
#        system below, so a Paladin-chassis Hero still pays rage for Bloodthirst
#        and energy for Sinister Strike.
#        Default: 2
#
#        Changing this on a live realm re-converts every character on their
#        next login and shifts their base stats. Decide before launch.

ClasslessWildcard.Chassis.Enable = 1
ClasslessWildcard.Chassis.Class = 2

########################################
# Universal resources
########################################
#
#    Every Hero maintains mana, rage AND energy pools simultaneously
#    (druid-style: the client tracks all pools; the chassis picks which bar
#    the default UI displays, and the addon shows the others as mini-bars
#    docked under the player frame). Players can change which pool the MAIN
#    bar shows with ".classless bar mana|rage|energy|default" or by clicking
#    a mini-bar; the choice persists per character.
#    Spells always draw from their native pool, energy/mana regenerate through
#    the core's normal regeneration, rage decays normally, and rage GAIN
#    mirrors the warrior formulas when the chassis is not natively rage
#    (scalable below). A spell whose power type is not the chassis's own is
#    always castable -- it pays out of the pool it actually uses.
#
#    Mana is left entirely alone. The chassis is required to be a real mana
#    class (see Chassis.Class above), so the pool, its base mana, its intellect
#    scaling and its Spirit regeneration all come from the core exactly as they
#    would for that class -- five-second rule included. Only rage and energy are
#    layered on, since the chassis has at most one of them natively. MaxRage is
#    in internal units (1000 = 100 displayed rage).
#
#    Spirit therefore behaves the way it does in the base game: it pays between
#    fights, and pauses for five seconds after a cast. A Hero who wants it to
#    pay DURING a fight buys a talent that lifts the rule -- Meditation, Arcane
#    Meditation or Intensity. Every Hero can buy any of the three, so that is a
#    build decision rather than a class one, and the module does not pre-empt
#    it.

ClasslessWildcard.UniversalResources.Enable = 1
ClasslessWildcard.UniversalResources.MaxRage = 1000
ClasslessWildcard.UniversalResources.MaxEnergy = 100
ClasslessWildcard.UniversalResources.RageFromDealtPct = 100
ClasslessWildcard.UniversalResources.RageFromTakenPct = 100

########################################
# Universal stats: every stat matters for every Hero
########################################
#
#    The shared chassis already applies its math uniformly (STR -> attack
#    power/block, STA -> health, AGI -> crit/dodge, INT -> mana/spell crit).
#    This layer fills the chassis's classless gaps so no allocated point is
#    ever wasted:
#      AGI  -> +MeleeAPPerAgility melee AP and +RangedAPPerAgility ranged AP
#              per point (rogue/hunter-style)
#      INT  -> +SpellPowerPerIntellect spell power per point above 10
#    Spirit and Stamina are untouched: the chassis already converts both, and
#    they behave exactly as the base game defines them.
#    Applies to all non-exempt players; bots keep vanilla stat rules.
#
#    Why SpellPowerPerIntellect is 0.5 and not 1.0: a point of spell power is
#    worth roughly four times a point of attack power (1 SP ~ 0.29 DPS on a 3s
#    full-coefficient nuke; 1 AP ~ 0.07 DPS), and the chassis already hands
#    melee 2 AP per point of Strength for free. At 1.0 a Hero's Intellect was
#    the best offensive stat in the game by a wide margin -- at endgame it
#    roughly DOUBLED a caster's spell power, where Agility adds well under half
#    that to a melee's attack power. At 0.5 one point of Intellect is worth
#    about one point of Strength for damage, and Intellect still carries mana
#    and spell crit on top, which is the caster's edge for paying a resource
#    cost per cast. Raise it if you want casters ahead on purpose.

ClasslessWildcard.UniversalStats.Enable = 1
ClasslessWildcard.UniversalStats.MeleeAPPerAgility = 1
ClasslessWildcard.UniversalStats.RangedAPPerAgility = 1
ClasslessWildcard.UniversalStats.SpellPowerPerIntellect = 0.5

########################################
# Primary stat allocation
########################################
#
#    Ascension's "choose your primary stat allocation, reallocate at will".
#    Budget = StartingPoints + PointsPerLevel * (level - 1); each point grants
#    ValuePerPoint of the chosen stat. Reallocation is free, via the addon's
#    Stats tab or .classless stat str|agi|sta|int|spi <points>.

ClasslessWildcard.Stats.Enable = 1
ClasslessWildcard.Stats.StartingPoints = 4
ClasslessWildcard.Stats.PointsPerLevel = 2
ClasslessWildcard.Stats.ValuePerPoint = 1

########################################
# Rebirth (late exit / mode switch)
########################################
#
#    ClasslessWildcard.Rebirth.Enable
#        Allow a full reset that wipes all abilities/talents and lets the
#        character switch path (classless <-> wildcard) after the mode-choice
#        deadline, for gold. Wildcard rebirths replay the whole roll schedule
#        for the character's level.
#        Default: 1
#
#    ClasslessWildcard.Rebirth.CostGold
#        Gold cost of a Rebirth.
#        Default: 100

ClasslessWildcard.Rebirth.Enable = 1
ClasslessWildcard.Rebirth.CostGold = 100

########################################
# Misc
########################################
#
#    ClasslessWildcard.NpcEntry
#        creature_template entry of the Hero Advancement NPC.
#        Default: 990100

ClasslessWildcard.NpcEntry = 990100
